# Required: ProtonMail credentials (Proton Bridge password for IMAP)
PROTONMAIL_USERNAME=you@protonmail.com
PROTONMAIL_PASSWORD=your-bridge-password

# SMTP settings (defaults work for Proton Bridge)
# PROTONMAIL_SMTP_HOST=smtp.protonmail.ch
# PROTONMAIL_SMTP_PORT=587

# IMAP settings (defaults work for local Proton Bridge)
# PROTONMAIL_IMAP_HOST=127.0.0.1
# PROTONMAIL_IMAP_PORT=1143
# PROTONMAIL_IMAP_TLS=false

# HTTP transport port (only used with --transport http)
# PORT=3000

# Enable debug logging
# DEBUG=false
