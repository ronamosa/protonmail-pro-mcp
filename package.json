{
  "name": "@sirency/protonmail-pro-mcp",
  "version": "2.0.0",
  "description": "ProtonMail MCP server for email management via Proton Bridge. Supports SMTP sending, IMAP reading, and folder management through the Model Context Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "protonmail-pro-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "protonmail",
    "mcp",
    "email",
    "model-context-protocol",
    "smtp",
    "imap",
    "proton-bridge"
  ],
  "author": {
    "name": "The Sirency Collective",
    "email": "contact@sirency.com",
    "url": "https://sirency.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/ronamosa/protonmail-pro-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronamosa/protonmail-pro-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ronamosa/protonmail-pro-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "nodemailer": "^8.0.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.19",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.16.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
